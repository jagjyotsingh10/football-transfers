model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

ref table League
ref table Club
ref table 'Club Portfolio'
ref table Composition
ref table 'Club KPIs'
ref table 'Club Volatility'
ref table Signings
ref table 'Fee vs Value'
ref table 'Transfer Balance'
ref table 'Value vs Points'
ref table 'Portfolio Players'
