table 'Value vs Points'
	lineageTag: b4df2bf4-63ef-5011-9d78-63670f1a32e3

	measure 'Avg Points per Game' = AVERAGE('Value vs Points'[points_per_game])
		formatString: 0.00
		lineageTag: ba68dd6a-fedd-50f7-b55e-c389b0472226

	measure 'Avg Value Index' = AVERAGE('Value vs Points'[value_index])
		formatString: 0.00
		lineageTag: 33585c0c-696e-5300-9d20-30045b72f755

	measure 'Title Rate (most valuable squad)' = DIVIDE(CALCULATE(COUNTROWS('Value vs Points'), 'Value vs Points'[value_rank] = 1, 'Value vs Points'[position] = 1), CALCULATE(COUNTROWS('Value vs Points'), 'Value vs Points'[value_rank] = 1))
		formatString: 0.0%
		lineageTag: 6e4404d1-2deb-58c7-91dc-f20b6ca34fa5

	measure 'Top-4 Rate (most valuable squad)' = DIVIDE(CALCULATE(COUNTROWS('Value vs Points'), 'Value vs Points'[value_rank] = 1, 'Value vs Points'[position] <= 4), CALCULATE(COUNTROWS('Value vs Points'), 'Value vs Points'[value_rank] = 1))
		formatString: 0.0%
		lineageTag: a8e2fa2d-c4a6-5adf-812f-fa8037e4c5ef

