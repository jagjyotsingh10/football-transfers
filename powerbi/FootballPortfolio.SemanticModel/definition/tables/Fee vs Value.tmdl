table 'Fee vs Value'
	lineageTag: 76ce162f-0509-5b43-afe7-4b9d011be778

	measure Deals = COUNTROWS('Fee vs Value')
		formatString: #,0
		lineageTag: 0949e541-451f-5078-bde8-85b5da6b0e3c

	measure 'Fee-to-Value Ratio' = DIVIDE(CALCULATE(SUM('Fee vs Value'[fee_eur]), 'Fee vs Value'[market_value_at_transfer_eur] > 0), CALCULATE(SUM('Fee vs Value'[market_value_at_transfer_eur]), 'Fee vs Value'[market_value_at_transfer_eur] > 0))
