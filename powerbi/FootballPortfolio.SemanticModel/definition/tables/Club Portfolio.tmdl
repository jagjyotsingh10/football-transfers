table 'Club Portfolio'
	lineageTag: 7ccd48a5-2036-5a12-930f-07555c65d10c

	measure 'Portfolio Value' = SUM('Club Portfolio'[total_value_eur])
		formatString: €#,0,,\m
		lineageTag: 5deebe3f-7ea1-565d-b3b1-65aeb0980ec3

	measure 'Latest Snapshot' = CALCULATE(MAX('Club Portfolio'[snapshot_date]), ALL('Club Portfolio'))
		formatString: yyyy-mm-dd
		lineageTag: ca81af19-cf36-5e2a-8396-0432eaaebfd8

	measure 'Portfolio Value (latest)' = VAR d = [Latest Snapshot] RETURN CALCULATE([Portfolio Value], 'Club Portfolio'[snapshot_date] = d)
		formatString: €#,0,,\m
		lineageTag: 9bc4282c-1ce7-539c-97b1-89f28817f0a2

	measure 'Portfolio Value (June 2020)' = CALCULATE([Portfolio Value], 'Club Portfolio'[snapshot_year] = 2020)
		formatString: €#,0,,\m
		lineageTag: 18bc7da4-59fb-5520-b7e4-23da44d12ed9

	measure 'Growth since June 2020' = DIVIDE([Portfolio Value (latest)] - [Portfolio Value (June 2020)], [Portfolio Value (June 2020)])
		formatString: 0.0%
		lineageTag: 06fba150-52f5-529b-b9ae-0e8d36823e75

	measure 'Clubs (latest)' = VAR d = [Latest Snapshot] RETURN CALCULATE(DISTINCTCOUNT('Club Portfolio'[club_id]), 'Club Portfolio'[snapshot_date] = d)
		formatString: 0
		lineageTag: 91353e7f-2aaf-5cd7-930d-c62132943ede

	measure 'Avg Value per Player (latest)' = VAR d = [Latest Snapshot] RETURN CALCULATE(DIVIDE(SUM('Club Portfolio'[total_value_eur]), SUM('Club Portfolio'[squad_size])), 'Club Portfolio'[snapshot_date] = d)
		formatString: €#,0.0,,\m
		lineageTag: 96eccf38-6c3a-5f71-ad95-0b28642e6e9a

	measure 'Top-5 Share (latest)' = VAR d = [Latest Snapshot] RETURN CALCULATE(DIVIDE(SUM('Club Portfolio'[top5_value_eur]), SUM('Club Portfolio'[total_value_eur])), 'Club Portfolio'[snapshot_date] = d)
		formatString: 0.0%
		lineageTag: a0d0d009-1065-534f-9e34-f127e868f3b8

	measure 'Declining Exposure' = DIVIDE(SUM('Club Portfolio'[declining_value_eur]), SUM('Club Portfolio'[value_with_history_eur]))
		formatString: 0.0%
		lineageTag: 4573abd5-eece-5249-8522-d3d6e802cfbc

	measure 'Declining Exposure (latest)' = VAR d = [Latest Snapshot] RETURN CALCULATE([Declining Exposure], 'Club Portfolio'[snapshot_date] = d)
		formatString: 0.0%
		lineageTag: bcb858c6-5f92-52de-a4c6-dd597e674d1a

	measure 'Value Lost (latest)' = VAR d = [Latest Snapshot] RETURN CALCULATE(SUM('Club Portfolio'[value_lost_eur]), 'Club Portfolio'[snapshot_date] = d)
		formatString: €#,0.0,,\m
		lineageTag: c0459bf3-ce9a-577b-b759-1d6a57a0fed4

