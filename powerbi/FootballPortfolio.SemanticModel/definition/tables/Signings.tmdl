table Signings
	lineageTag: 72bd7213-9459-5b5b-8e6b-fbbe3cc3a7d7

	measure 'Paid Signings' = COUNTROWS(Signings)
		formatString: #,0
		lineageTag: d25d786b-c718-5653-850f-c87de75d069f

	measure 'Median Appreciation' = MEDIAN(Signings[appreciation_pct]) / 100
		formatString: 0.0%
		lineageTag: aa04b6d2-20c5-5b26-8427-2154329767da

	measure 'Share Gaining Value' = DIVIDE(CALCULATE(COUNTROWS(Signings), Signings[appreciation_eur] > 0), CALCULATE(COUNTROWS(Signings), NOT ISBLANK(Signings[appreciation_eur])))
		formatString: 0.0%
		lineageTag: 0fae52ff-55ba-5f93-84ac-cbc954f54187

