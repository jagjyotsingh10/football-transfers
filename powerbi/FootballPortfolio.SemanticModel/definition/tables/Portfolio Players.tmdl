		summarizeBy: none
		sourceColumn: player_name

		annotation SummarizationSetBy = User

	column position
		dataType: string
		lineageTag: 13c12e98-1c21-500a-acad-84ed990d98e6
		summarizeBy: none
		sourceColumn: position

		annotation SummarizationSetBy = User

	column market_value_eur
		dataType: double
		formatString: €#,0,,.0\m
		lineageTag: 4e875d2d-75e1-57ee-8a9e-42e0057560b5
		summarizeBy: none
		sourceColumn: market_value_eur

		annotation SummarizationSetBy = User

	column valuation_date
		dataType: dateTime
		formatString: yyyy-mm-dd
