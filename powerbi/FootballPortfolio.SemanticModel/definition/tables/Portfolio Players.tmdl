table 'Portfolio Players'
	lineageTag: a478a668-9a3b-5027-b581-de6d4c82a1a3

	measure 'Player Value (latest)' = VAR d = CALCULATE(MAX('Portfolio Players'[snapshot_date]), ALL('Portfolio Players')) RETURN CALCULATE(SUM('Portfolio Players'[market_value_eur]), 'Portfolio Players'[snapshot_date] = d)
		formatString: €#,0,,.0\m
		lineageTag: 4286089a-3bac-51d0-bc80-ab0532d095b9

	measure 'Player Age (latest)' = VAR d = CALCULATE(MAX('Portfolio Players'[snapshot_date]), ALL('Portfolio Players')) RETURN IF(HASONEVALUE('Portfolio Players'[player_id]), CALCULATE(MAX('Portfolio Players'[age_years]), 'Portfolio Players'[snapshot_date] = d))
		formatString: 0.0
		lineageTag: 07312692-597e-554e-ad55-3dd778990ea7

	column snapshot_date
		dataType: dateTime
		formatString: yyyy-mm-dd
		lineageTag: 4a560ba8-eb18-56de-b605-339c1c8e9acd
		summarizeBy: none
		sourceColumn: snapshot_date

		annotation SummarizationSetBy = User

	column club_id
		dataType: int64
		isHidden
		lineageTag: d30458f6-32c0-53e0-84bb-5594eb31321b
		summarizeBy: none
		sourceColumn: club_id

		annotation SummarizationSetBy = User

	column player_id
		dataType: int64
		isHidden
